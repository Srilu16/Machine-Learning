import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.cluster import KMeans
from sklearn.metrics import (
    mean_squared_error,
    r2_score,
    silhouette_score,
    calinski_harabasz_score,
    davies_bouldin_score
)

# =========================
# LOAD DATASET
# =========================
df = pd.read_csv("dataset.csv").dropna()

X = df.iloc[:, :-1].values

# =========================
# A1 + A2 LINEAR REGRESSION
# =========================

# use first feature as input, second as target (lab requirement)
X_reg = X[:, 0].reshape(-1, 1)
y_reg = X[:, 1]

X_train, X_test, y_train, y_test = train_test_split(
    X_reg, y_reg, test_size=0.3, random_state=42
)

reg = LinearRegression()
reg.fit(X_train, y_train)

y_train_pred = reg.predict(X_train)
y_test_pred = reg.predict(X_test)

def metrics(y_true, y_pred, name):
    mse = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    r2 = r2_score(y_true, y_pred)

    print(f"\n{name}")
    print("MSE :", mse)
    print("RMSE:", rmse)
    print("MAPE:", mape)
    print("R2  :", r2)

metrics(y_train, y_train_pred, "TRAIN METRICS")
metrics(y_test, y_test_pred, "TEST METRICS")


# =========================
# A4 - K-MEANS CLUSTERING
# =========================

X_cluster = X

X_train_c, X_test_c = train_test_split(
    X_cluster, test_size=0.3, random_state=42
)

kmeans = KMeans(n_clusters=2, random_state=42, n_init="auto")
kmeans.fit(X_train_c)

labels = kmeans.labels_

print("\nCluster Centers:\n", kmeans.cluster_centers_)


# =========================
# A5 - CLUSTER EVALUATION
# =========================

print("\n--- Clustering Metrics ---")
print("Silhouette Score:", silhouette_score(X_train_c, labels))
print("Calinski-Harabasz Score:", calinski_harabasz_score(X_train_c, labels))
print("Davies-Bouldin Index:", davies_bouldin_score(X_train_c, labels))


# =========================
# A7 - ELBOW METHOD
# =========================

distortions = []

for k in range(2, 11):
    km = KMeans(n_clusters=k, random_state=42, n_init="auto")
    km.fit(X_train_c)
    distortions.append(km.inertia_)

plt.plot(range(2, 11), distortions, marker='o')
plt.xlabel("k")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()
